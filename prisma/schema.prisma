generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HealthStatus {
  UP
  DOWN
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  role      UserRole  @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  services  Service[]

  @@map("users")
}

model Service {
  id           String        @id @default(uuid())
  name         String
  url          String        @unique
  healthStatus HealthStatus  @default(DOWN)
  userId       String?
  user         User?         @relation(fields: [userId], references: [id])
  healthChecks HealthCheck[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("services")
}

model HealthCheck {
  id           String       @id @default(uuid())
  serviceId    String
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  status       HealthStatus
  responseTime Int? // in milliseconds
  errorMessage String?
  checkedAt    DateTime     @default(now())

  @@map("health_checks")
}

model Email {
  id        String   @id @default(uuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("emails")
}
